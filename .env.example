# ==========================================
# PHEV-Tracker Konfigurationsdatei (.env)
# ==========================================

# 1. Netzwerk & Port
# 0.0.0.0 bindet an alle Netzwerkkarten (LAN + NordVPN Meshnet)
HOST=0.0.0.0
PORT=3000

# 2. Daten-Persistenz (SQLite)
# Pfad zur SQLite-Datenbankdatei.
# Für den Homeserver empfiehlt sich ein Pfad außerhalb des Git-Repo, z. B.:
# Windows: C:/PHEV_Data/phev.db
# Linux:   /var/lib/phev-tracker/phev.db
DB_PATH=./backend/data/phev.db

# Zielordner für automatische Backups (Standard: <DB_DIR>/backups)
BACKUP_DIR=./backend/data/backups
# Vorhaltezeit für automatische Backups in Tagen (ältere werden gelöscht)
BACKUP_RETENTION_DAYS=30

# 3. Sicherheit (Optional / Empfohlen für Meshnet-Zugriff)
# Basic Auth Schutz vor der App
# Wenn gesetzt, fragt der Browser nach Benutzername und Passwort
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=geheimes-passwort-hier-aendern

# Verschlüsselungsschlüssel für sensible Zugangsdaten (z. B. Kia Connect)
# 32 Bytes / min. 16 Zeichen Zufallszeichenfolge
ENCRYPTION_KEY=ein-sehr-sicherer-geheimer-schluessel-12345

# 4. Logging
LOG_DIR=./logs
